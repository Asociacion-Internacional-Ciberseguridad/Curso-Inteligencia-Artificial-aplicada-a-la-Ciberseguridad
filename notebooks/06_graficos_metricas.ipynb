      "source": [
        "# Gráficos y métricas\n",
        "\n",
        "Visualización simple de ataques por tipo."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "df = pd.read_csv(\"access.csv\")\n",
        "df[df[\"es_ataque\"] == 1][\"tipo_ataque\"].value_counts().plot(kind=\"bar\")\n",
        "plt.title(\"Ataques por tipo\")\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    }
  ],
